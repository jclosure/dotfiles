# .emacs.d is now the chemacs2 submodule (bootstrap only, doesn't
# accumulate this stuff) and ide is a submodule with its own ignores.
# These unanchored patterns cover generated state in any plain-directory
# profile living directly in this repo (minimal/, light/, experimental/)
# at any depth.

# Byte/native compilation artifacts
*.elc
eln-cache/

# Installed packages (reinstalled by package.el / straight / etc.)
elpa/
straight/

# Auto-generated bootstrap file
package-quickstart.el

# Runtime/state data — recentf, savehist, undo history, backups, autosaves,
# persistent scratch, eshell history, custom.el, etc.
etc/
var/

# Misc local state
places
history
transient/
tramp
url/
auto-save-list/
