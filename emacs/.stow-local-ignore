# A custom .stow-local-ignore replaces (not merges with) GNU Stow's
# built-in ignore list, so the built-in defaults are reproduced here
# alongside our own entries.

# GNU Stow built-in defaults
RCS
.+,v
CVS
\.\#.+          # CVS conflict files / Emacs lock files
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
.+~             # Emacs backup files
\#.*\#          # Emacs autosave files

^/README.*
^/LICENSE.*
^/COPYING

# macOS
\.DS_Store

# Vim
.*\.swp
.*\.swo
.*\.swn

# Stow metadata
\.stow-local-ignore

# Chemacs2 profile directories. These are referenced directly by their
# repo path from .emacs-profiles.el (see that file) — they should NOT be
# symlinked into $HOME. Only .emacs.d (chemacs2 itself) and
# .emacs-profiles.el get stowed.
^/minimal$
^/light$
^/ide$
^/experimental$
