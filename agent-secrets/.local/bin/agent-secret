#!/bin/sh
set -eu

service="${AGENT_SECRETS_KEYCHAIN_SERVICE:-com.joelholder.agent-secrets}"
map_file="${AGENT_SECRETS_MAP:-$HOME/.config/agent-secrets/env-map}"

usage() {
  cat >&2 <<'EOF'
Usage:
  agent-secret list
  agent-secret get ENV_NAME
  agent-secret set ENV_NAME
  agent-secret delete ENV_NAME

Values are stored in the macOS Keychain. `get` writes the value to stdout;
avoid terminal history, logs, command substitution, and clipboard capture.
EOF
  exit 2
}

account_for() {
  name=$1
  [ -r "$map_file" ] || { echo "agent-secret: missing map: $map_file" >&2; exit 1; }
  account=$(awk -F= -v name="$name" '
    /^[[:space:]]*(#|$)/ { next }
    $1 == name { print $2; exit }
  ' "$map_file")
  [ -n "$account" ] || { echo "agent-secret: unknown variable: $name" >&2; exit 1; }
  printf '%s\n' "$account"
}

[ $# -ge 1 ] || usage
command=$1
shift

case "$command" in
  list)
    [ $# -eq 0 ] || usage
    awk -F= '/^[A-Za-z_][A-Za-z0-9_]*=/ { print $1 }' "$map_file"
    ;;
  get)
    [ $# -eq 1 ] || usage
    account=$(account_for "$1")
    /usr/bin/security find-generic-password -a "$account" -s "$service" -w
    ;;
  set)
    [ $# -eq 1 ] || usage
    account=$(account_for "$1")
    printf 'Enter value for %s (input is managed by macOS Keychain):\n' "$1" >&2
    # A trailing -w prompts securely and asks for confirmation; the value never
    # appears in argv, shell history, or this repository.
    /usr/bin/security add-generic-password -U \
      -a "$account" -s "$service" \
      -l "Agent secret: $account" \
      -j "Shared CLI agent credential" -w
    ;;
  delete)
    [ $# -eq 1 ] || usage
    account=$(account_for "$1")
    /usr/bin/security delete-generic-password -a "$account" -s "$service" >/dev/null
    printf 'Deleted Keychain item for %s\n' "$account" >&2
    ;;
  *) usage ;;
esac
