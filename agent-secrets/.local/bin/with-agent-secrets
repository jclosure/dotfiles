#!/bin/sh
set -eu

service="${AGENT_SECRETS_KEYCHAIN_SERVICE:-com.joelholder.agent-secrets}"
map_file="${AGENT_SECRETS_MAP:-$HOME/.config/agent-secrets/env-map}"

usage() {
  cat >&2 <<'EOF'
Usage: with-agent-secrets [--only NAME[,NAME...]] -- command [args...]

Loads mapped credentials from macOS Keychain into only the command's
environment, then replaces this wrapper with that command.

Examples:
  with-agent-secrets -- pi
  with-agent-secrets -- claude
  with-agent-secrets --only GITHUB_TOKEN,GH_TOKEN -- gh auth status
EOF
  exit 2
}

only=""
if [ "${1:-}" = "--only" ]; then
  [ $# -ge 3 ] || usage
  only=$2
  shift 2
fi
[ "${1:-}" = "--" ] && shift
[ $# -ge 1 ] || usage
[ -r "$map_file" ] || { echo "with-agent-secrets: missing map: $map_file" >&2; exit 1; }

wanted() {
  [ -z "$only" ] && return 0
  case ",$only," in
    *,$1,*) return 0 ;;
    *) return 1 ;;
  esac
}

while IFS='=' read -r name account; do
  case "$name" in ''|'#'*) continue ;; esac
  case "$name" in *[!A-Za-z0-9_]*) continue ;; esac
  wanted "$name" || continue
  value=$(/usr/bin/security find-generic-password -a "$account" -s "$service" -w 2>/dev/null) || {
    echo "with-agent-secrets: missing Keychain item for $name" >&2
    exit 1
  }
  export "$name=$value"
  unset value
done < "$map_file"

exec "$@"
